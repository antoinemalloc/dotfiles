{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",


"permissions": [
  { "action": "read", "resource": "*.env*", "effect": "deny" },
  { "action": "read", "resource": "*.pem", "effect": "deny" },
  { "action": "read", "resource": "*.key", "effect": "deny" },
  { "action": "read", "resource": "*.p12", "effect": "deny" },
  { "action": "read", "resource": "*.pfx", "effect": "deny" },
  { "action": "read", "resource": "*.jks", "effect": "deny" },
  { "action": "read", "resource": "*.keystore", "effect": "deny" },
  { "action": "read", "resource": "*credentials*", "effect": "deny" },
  { "action": "read", "resource": "*secret*", "effect": "deny" },
  { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
  { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
  { "action": "read", "resource": "*.tfstate*", "effect": "deny" },
  { "action": "edit", "resource": "*.env*", "effect": "deny" },
  { "action": "edit", "resource": "*.pem", "effect": "deny" },
  { "action": "edit", "resource": "*.key", "effect": "deny" },
  { "action": "edit", "resource": "*.p12", "effect": "deny" },
  { "action": "edit", "resource": "*.pfx", "effect": "deny" },
  { "action": "edit", "resource": "*.jks", "effect": "deny" },
  { "action": "edit", "resource": "*.keystore", "effect": "deny" },
  { "action": "edit", "resource": "*credentials*", "effect": "deny" },
  { "action": "edit", "resource": "*secret*", "effect": "deny" },
  { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },
  { "action": "edit", "resource": "*id_ed25519*", "effect": "deny" },
  { "action": "edit", "resource": "*.tfstate*", "effect": "deny" },

  { "action": "external_directory", "resource": "*", "effect": "ask" },

  { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.gnupg/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.aws/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.azure/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.kube/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.docker/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.config/gcloud/*", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.netrc", "effect": "deny" },
  { "action": "external_directory", "resource": "~/.npmrc", "effect": "deny" },

  { "action": "shell", "resource": "git commit", "effect": "deny" },
  { "action": "shell", "resource": "git commit *", "effect": "deny" },
  { "action": "shell", "resource": "git commit*", "effect": "deny" },
  { "action": "shell", "resource": "git push", "effect": "deny" },
  { "action": "shell", "resource": "git push *", "effect": "deny" },
  { "action": "shell", "resource": "git push*", "effect": "deny" }
],

  // Custom providers
  "providers": {
    "ALBERT": {
      "name": "ALBERT API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://albert.api.etalab.gouv.fr/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b"
        },
        "qwen3-coder-30b-A3b-instruct": {
          "name": "qwen3-coder-30b-A3b-instruct"
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        }
      }
    }
  },
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  }
}