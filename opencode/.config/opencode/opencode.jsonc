{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "permissions": [
    {
      "action": "read",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.azure/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.p12",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.jks",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*credentials*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.azure/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/gcloud/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *credentials*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *.env*",
      "effect": "deny"
    }
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "build": {
      "disabled": false
    },
    "plan": {
      "disabled": false
    }
  },
  "providers": {
    "ALBERT": {
      "name": "ALBERT API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://albert.api.etalab.gouv.fr/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b"
        },
        "qwen3-coder-30b-A3b-instruct": {
          "name": "qwen3-coder-30b-A3b-instruct"
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
