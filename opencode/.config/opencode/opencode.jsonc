{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  // OpenCode V2 permission rules.
  // Ordered array of {action, resource, effect}. LAST matching rule wins,
  // so general rules come first and specific exceptions last.
  // Actions are shell (not bash), read, edit, webfetch, websearch,
  // external_directory. Effects are allow | deny | ask.
  // Resources are whole-value wildcards anchored ^...$: "*" matches any
  // characters including "/". A trailing " *" also matches the bare command.
  // "~" expands only for read/edit/external_directory, never for shell.
  "permissions": [
    // --- read: allow, then deny secrets ---
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": ".env*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "read", "resource": "*secret*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },

    // --- edit: allow, then deny secrets ---
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*credentials*", "effect": "deny" },

    // --- external_directory: ask, then deny credential stores ---
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.azure/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.docker/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gcloud/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.netrc", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.npmrc", "effect": "deny" },

    // --- network ---
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" },

    // --- shell: allow, then deny state-changing git, then ask the rest ---
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git add*", "effect": "deny" },
    { "action": "shell", "resource": "git rm*", "effect": "deny" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git checkout*", "effect": "deny" },
    { "action": "shell", "resource": "git switch*", "effect": "deny" },
    { "action": "shell", "resource": "git restore*", "effect": "deny" },
    { "action": "shell", "resource": "git rebase*", "effect": "deny" },
    { "action": "shell", "resource": "git merge*", "effect": "deny" },
    { "action": "shell", "resource": "git pull*", "effect": "deny" },
    { "action": "shell", "resource": "git cherry-pick*", "effect": "deny" },
    { "action": "shell", "resource": "git revert*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "git stash*", "effect": "deny" },
    { "action": "shell", "resource": "git config*", "effect": "deny" },
    { "action": "shell", "resource": "git apply*", "effect": "deny" },
    { "action": "shell", "resource": "git tag -d*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -d*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree add*", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "ask" },
    { "action": "shell", "resource": "scp *", "effect": "ask" },
    { "action": "shell", "resource": "npm install*", "effect": "ask" },
    { "action": "shell", "resource": "npm i *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add*", "effect": "ask" },
    { "action": "shell", "resource": "yarn add*", "effect": "ask" },
    { "action": "shell", "resource": "pip install*", "effect": "ask" },
    { "action": "shell", "resource": "pip uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "brew install*", "effect": "ask" },
    { "action": "shell", "resource": "apt *", "effect": "ask" },
    { "action": "shell", "resource": "apt-get *", "effect": "ask" },
    { "action": "shell", "resource": "dnf *", "effect": "ask" },
    { "action": "shell", "resource": "yum *", "effect": "ask" },
    { "action": "shell", "resource": "git fetch*", "effect": "ask" },
    { "action": "shell", "resource": "docker pull*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl *", "effect": "ask" },
    { "action": "shell", "resource": "terraform apply*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" }
  ],
  "providers": {
    "ALBERT": {
      "name": "ALBERT API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://albert.api.etalab.gouv.fr/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b"
        },
        "qwen3-coder-30b-A3b-instruct": {
          "name": "qwen3-coder-30b-A3b-instruct"
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}