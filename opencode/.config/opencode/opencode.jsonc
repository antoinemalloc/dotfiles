{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "permission": {
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": {
      "*": "ask",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny"
    },
    "read": {
      "*": "allow",
      ".env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*credentials*": "deny",
      "*secret*": "deny",
      "~/.ssh/*": "deny"
    },
    "edit": {
      "*": "allow",
      ".env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*credentials*": "deny"
    },
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git add*": "deny",
      "git rm*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git restore*": "deny",
      "git rebase*": "deny",
      "git merge*": "deny",
      "git pull*": "deny",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "git config*": "deny",
      "git apply*": "deny",
      "git tag -d*": "deny",
      "git branch -d*": "deny",
      "git worktree add*": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "pnpm add*": "ask",
      "yarn add*": "ask",
      "pip install*": "ask",
      "pip uninstall*": "ask",
      "brew install*": "ask",
      "apt *": "ask",
      "apt-get *": "ask",
      "dnf *": "ask",
      "yum *": "ask",
      "git fetch*": "ask",
      "docker pull*": "ask",
      "kubectl *": "ask",
      "terraform apply*": "ask",
      "sudo *": "ask",
      "rm -rf *": "ask"
    }
  },
  "providers": {
    "ALBERT": {
      "name": "ALBERT API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://albert.api.etalab.gouv.fr/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "openai/gpt-oss-120b": {
          "name": "openai/gpt-oss-120b"
        },
        "qwen3-coder-30b-A3b-instruct": {
          "name": "qwen3-coder-30b-A3b-instruct"
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
